SECRET_KEY=
DEBUG=True
# Production only: comma-separated hostnames the site is served on
ALLOWED_HOSTS=

# Database (dev settings)
DB_DEV_NAME=
DB_DEV_USER=
DB_DEV_PASSWORD=
DB_DEV_HOST=
DB_DEV_PORT=

# Database (prod settings; use DB_HOST=db with docker-compose.prod.yml)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# JWT: access token lifetime in minutes, refresh token lifetime in days
ACCESS_TOKEN_LIFETIME=5
REFRESH_TOKEN_LIFETIME=1

# CELERY (docker-compose.prod.yml builds these URLs from REDIS_PASSWORD)
BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_CACHE_BACKEND=
# Required by docker-compose.prod.yml. Use a URL-safe value: openssl rand -hex 32
REDIS_PASSWORD=

# SENTRY
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
